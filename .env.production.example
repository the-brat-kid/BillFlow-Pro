# =========================================================
# PRODUCTION ENVIRONMENT TEMPLATE
# Copy this to `.env.production` on your PRODUCTION server
# and fill in real values. NEVER commit the filled-in file.
# =========================================================

# Database (point these to your production DB host, not localhost)
DATABASE_URL=postgresql+asyncpg://billflow:CHANGE_ME@your-db-host:5432/billflow
MONGODB_URL=mongodb://billflow:CHANGE_ME@your-mongo-host:27017/billflow?authSource=admin
REDIS_URL=redis://your-redis-host:6379/0

# JWT / App secret — generate a long random string, do not reuse the dev secret
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Razorpay (use LIVE keys, not test keys, in production)
RAZORPAY_KEY_ID=rzp_live_your_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# AI APIs
GEMINI_API_KEY=your_gemini_api_key
CLAUDE_API_KEY=your_claude_api_key

# ---------------------------------------------------------
# Frontend / API URLs — MUST be your real HTTPS domains.
# These NEXT_PUBLIC_* values get baked into the frontend at
# BUILD time (see frontend/Dockerfile), so they must be
# passed as --build-arg / docker-compose build args, not just
# set as container runtime env vars.
# ---------------------------------------------------------
FRONTEND_URL=https://www.vatsaai.com
NEXT_PUBLIC_API_URL=https://api.vatsaai.com
NEXT_PUBLIC_WS_URL=wss://api.vatsaai.com
NEXT_PUBLIC_NODE_API_URL=https://api.vatsaai.com

# Comma-separated list of origins allowed to call backend-node's API/WebSocket
ALLOWED_ORIGINS=https://www.vatsaai.com,https://vatsaai.com

# SMTP (Email Settings) — rotate any credentials that were ever shared/exposed
MAIL_USERNAME=billflowpro@gmail.com
MAIL_PASSWORD=CHANGE_ME_APP_PASSWORD
MAIL_FROM=invoices@vatsaai.com
MAIL_PORT=465
MAIL_SERVER=smtp.gmail.com
RESEND_API_KEY=CHANGE_ME_RESEND_KEY
